{
    admin off
    auto_https off

    # Exact, operator-configured sources only. The safe Compose default is
    # loopback, never the broad private_ranges shortcut.
    servers {
        trusted_proxies static {$OPENPAY_TRUSTED_PROXY_CIDRS:127.0.0.1/32}
        trusted_proxies_strict
    }
}

:8080 {
    root * /var/www/html/public
    encode zstd gzip
    php_server
}
