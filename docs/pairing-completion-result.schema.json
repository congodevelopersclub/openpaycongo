{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpaycongo.example/schemas/pairing-completion-result.schema.json",
  "title": "Pairing completion result envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "nonce", "ciphertext"],
  "properties": {
    "state": { "const": "pending_confirmation" },
    "nonce": { "$ref": "#/$defs/bytes24" },
    "ciphertext": {
      "description": "Unpadded base64url encoding of 85 bytes: exact pending-confirmation JSON plus AEAD tag.",
      "$ref": "#/$defs/bytes85"
    }
  },
  "$defs": {
    "bytes24": { "type": "string", "pattern": "^[A-Za-z0-9_-]{32}$" },
    "bytes85": { "type": "string", "pattern": "^[A-Za-z0-9_-]{114}$" }
  }
}
