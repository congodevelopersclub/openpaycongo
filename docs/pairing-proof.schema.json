{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpaycongo.example/schemas/pairing-proof.schema.json",
  "title": "Pairing completion encrypted proof plaintext",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "install_id", "device_signing_public_key", "signature"],
  "properties": {
    "version": { "const": "1" },
    "install_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "device_signing_public_key": { "$ref": "#/$defs/bytes32" },
    "signature": { "$ref": "#/$defs/bytes64" }
  },
  "$defs": {
    "bytes32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "bytes64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
