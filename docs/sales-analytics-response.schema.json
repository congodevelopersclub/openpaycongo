{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpaycongo.example/schemas/sales-analytics-response.schema.json",
  "title": "Sales analytics dashboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "projection_version", "readiness", "tenant_id", "snapshot_at", "observed_at", "time_zone", "current", "series", "reconciliation", "sync", "action_required", "etag"],
  "properties": {
    "contract_version": { "const": "sales-analytics-v1" },
    "projection_version": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "readiness": { "const": "ready" },
    "tenant_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "snapshot_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "observed_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "description": "Server-trusted clock used for operational freshness." },
    "time_zone": { "type": "string", "minLength": 1, "maxLength": 64 },
    "current": { "$ref": "#/$defs/window" },
    "comparison": { "$ref": "#/$defs/window" },
    "series": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/window" } },
    "reconciliation": {
      "type": "object", "additionalProperties": false, "required": ["lag_seconds_max", "unreconciled_count"],
      "properties": { "lag_seconds_max": { "$ref": "#/$defs/count" }, "unreconciled_count": { "$ref": "#/$defs/count" } }
    },
    "sync": {
      "type": "object", "additionalProperties": false, "required": ["status"],
      "properties": { "status": { "enum": ["no_events", "fresh", "stale"] }, "last_received_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }, "freshness_seconds": { "$ref": "#/$defs/count" } },
      "oneOf": [
        { "properties": { "status": { "const": "no_events" }, "last_received_at": true, "freshness_seconds": true }, "not": { "anyOf": [{ "properties": { "last_received_at": true }, "required": ["last_received_at"] }, { "properties": { "freshness_seconds": true }, "required": ["freshness_seconds"] }] } },
        { "properties": { "status": { "enum": ["fresh", "stale"] }, "last_received_at": true, "freshness_seconds": true }, "required": ["last_received_at", "freshness_seconds"] }
      ]
    },
    "action_required": {
      "type": "array", "maxItems": 32,
      "items": { "type": "object", "additionalProperties": false, "required": ["kind", "count", "action"], "properties": { "kind": { "enum": ["late_arrival", "orphan_correction", "over_refund", "reconciliation_overdue", "stale_sync", "correction_after_void", "correction_mismatch", "lifecycle_conflict"] }, "count": { "$ref": "#/$defs/count" }, "action": { "enum": ["review_offline_sync", "repair_event_linkage", "review_refund_total", "reconcile_provider", "check_replica_sync", "review_correction_order", "review_correction_identity", "review_correction_lifecycle"] } } }
    },
    "etag": { "type": "string", "pattern": "^\"[a-f0-9]{64}\"$" }
  },
  "$defs": {
    "count": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "amount": { "type": "string", "pattern": "^-?(0|[1-9][0-9]{0,25})$" },
    "currencyMetrics": {
      "type": "object", "additionalProperties": false,
      "required": ["currency", "gross_minor", "refunds_minor", "net_minor", "payment_count", "refund_count", "average_ticket_minor"],
      "properties": { "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "gross_minor": { "$ref": "#/$defs/amount" }, "refunds_minor": { "$ref": "#/$defs/amount" }, "net_minor": { "$ref": "#/$defs/amount" }, "payment_count": { "$ref": "#/$defs/count" }, "refund_count": { "$ref": "#/$defs/count" }, "average_ticket_minor": { "$ref": "#/$defs/amount" } }
    },
    "providerMetrics": {
      "type": "object", "additionalProperties": false, "required": ["provider", "currencies"],
      "properties": { "provider": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" }, "currencies": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/currencyMetrics" } } }
    },
    "window": {
      "type": "object", "additionalProperties": false, "required": ["from", "to", "currencies", "providers"],
      "properties": { "from": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }, "to": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }, "currencies": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/currencyMetrics" } }, "providers": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/providerMetrics" } } }
    }
  }
}
