{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpaycongo.example/schemas/pairing-completion.schema.json",
  "title": "Pairing completion envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent_id", "client_public_key", "nonce", "ciphertext"],
  "properties": {
    "intent_id": { "$ref": "#/$defs/bytes16" },
    "client_public_key": { "$ref": "#/$defs/bytes32" },
    "nonce": { "$ref": "#/$defs/bytes24" },
    "ciphertext": {
      "description": "Unpadded base64url encoding of 48 bytes: encrypted 32-byte secret plus AEAD tag.",
      "$ref": "#/$defs/bytes48"
    }
  },
  "$defs": {
    "bytes16": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" },
    "bytes24": { "type": "string", "pattern": "^[A-Za-z0-9_-]{32}$" },
    "bytes32": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "bytes48": { "type": "string", "pattern": "^[A-Za-z0-9_-]{64}$" }
  }
}
